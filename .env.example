APP_NAME="Gutlicious POS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gutlicious_pos
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Restaurant Business Defaults
RESTAURANT_NAME="Gutlicious Healthy Kitchen"
RESTAURANT_GSTIN="06ABCDE1234F1Z8"
TAX_CGST_PERCENT=2.5
TAX_SGST_PERCENT=2.5
PRINTER_WIDTH=80mm
